<component type="desktop-application">
  <id>io.github.emsi.OneNoteViewer</id>
  <name>OneNote Viewer</name>
  <summary>View and search local Microsoft OneNote notebooks</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.emsi">
    <name>Mariusz Woloszyn</name>
  </developer>
  <description>
    <p>
      OneNote Viewer is a native, read-only Linux application for opening,
      rendering, indexing, and searching local Microsoft OneNote notebooks
      while preserving their freeform page layout.
    </p>
    <p>
      It opens native OneNote sections, notebook directories, and OneNote
      package exports without converting pages to HTML or Markdown.
    </p>
  </description>
  <launchable type="desktop-id">io.github.emsi.OneNoteViewer.desktop</launchable>
  <provides>
    <binary>onenote-viewer</binary>
  </provides>
  <url type="homepage">https://github.com/emsi/OneNoteViewer</url>
  <url type="bugtracker">https://github.com/emsi/OneNoteViewer/issues</url>
  <url type="vcs-browser">https://github.com/emsi/OneNoteViewer</url>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.1" date="2026-07-29">
      <description>
        <p>
          Correct Flatpak application metadata, stable-branch packaging, and
          versioned release artifacts.
        </p>
      </description>
      <url type="details">https://github.com/emsi/OneNoteViewer/releases/tag/v0.1.1</url>
    </release>
    <release version="0.1.0" date="2026-07-29">
      <description>
        <p>Initial public preview release.</p>
      </description>
      <url type="details">https://github.com/emsi/OneNoteViewer/releases/tag/v0.1.0</url>
    </release>
  </releases>
</component>
